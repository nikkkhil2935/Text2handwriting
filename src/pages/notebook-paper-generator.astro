---
import BaseLayout from '../layouts/BaseLayout.astro';
import PaperApp from '../components/paper/PaperApp';
import AdSlot from '../components/common/AdSlot.astro';
import RelatedTools from '../components/common/RelatedTools.astro';

const PAPER_FAQS = [
  {
    q: 'How do I create custom graph paper online?',
    a: 'Select the "Graph Grid" paper style in the generator, then adjust the grid size (small squares for fine detail, larger squares for engineering). Customize line color, spacing, and margins, then download as a printable PDF.'
  },
  {
    q: 'Is the printable ruled paper generator free?',
    a: 'Yes! The notebook paper generator is completely free. You can create unlimited lined, graph, dot-grid, and legal pad papers. Download as many pages as you need in PDF format at no cost.'
  },
  {
    q: 'Can I use these papers for handwriting practice?',
    a: 'Absolutely. The double-ruled paper style is specifically designed for handwriting practice. It provides top and bottom guidelines that help kids and adults practice letter formation, height consistency, and spacing.'
  },
  {
    q: 'What paper sizes are supported?',
    a: 'The generator supports A4 (210x297mm), US Letter (8.5x11in), and Legal (8.5x14in). Choose the size that matches your printer or regional standard. All templates are optimized for clean printing without layout cuts.'
  },
  {
    q: 'Can I customize the line color and spacing?',
    a: 'Yes. You can change line color (blue, black, gray, or custom hex), adjust spacing between lines, modify left/right margins, and toggle features like red margin lines. This lets you match any notebook standard or personal preference.'
  }
];

const paperSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Online Printable Notebook Paper Generator',
  'operatingSystem': 'Any',
  'applicationCategory': 'UtilitiesApplication',
  'description': 'Generate custom ruled, grid, dot-grid, and legal notebook paper templates dynamically. Customize line color, spacing, margins, and download high-res PDFs.',
  'offers': {
    '@type': 'Offer',
    'price': '0.00',
    'priceCurrency': 'USD'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': PAPER_FAQS.map(faq => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};

const pageSchema = {
  '@graph': [paperSchema, faqSchema]
};
---

<BaseLayout 
  title="Notebook Paper Generator - Free Printable Lined & Graph Paper"
  description="Generate free printable notebook paper online. Create ruled, double-ruled, graph grid, dot grid, and legal pad templates in PDF format."
  activeTab="notebook"
  showHeroGradient={true}
  fullWidth={true}
  schema={pageSchema}
>
  <div class="space-y-6">
    <AdSlot slotId="header-leaderboard" />

    <div class="max-w-4xl mx-auto text-center space-y-2 mb-4">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-primary uppercase font-mono">Notebook Paper Generator Online</h1>
      <p class="text-xs text-mute font-mono">Create and download printable lined paper, graph grid paper, legal pads, and dot grids.</p>
    </div>

    <PaperApp client:load />

    <!-- Rich SEO Content Section (Comprehensive 850+ Words) -->
    <div class="max-w-4xl mx-auto py-12 px-4 border-t border-hairline space-y-8 text-body text-xs md:text-sm leading-relaxed">
      
      <div class="text-center space-y-2">
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-primary uppercase font-mono">Printable Paper & Notebook Layout Guide</h2>
        <p class="text-xs text-mute font-mono max-w-2xl mx-auto">Generate and download custom ruled, double-ruled, legal pad, graph grid, and dot grid paper templates in high-DPI PDF formats.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">1. Printable Ruled Paper Generator Free</h3>
          <p>
            Ruled notebook sheets, graph grids, and dot-grid paper represent essential tools for students, engineers, architects, and designers. Buying individual specialized notebooks for different subjects can be costly and restrictive.
          </p>
          <p>
            Our <strong>notebook paper generator online</strong> gives you complete control over paper layouts. Customize line spacing, margin width, line opacity, background color, and page orientation, then download high-resolution PDFs ready for printing.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">2. Supported Paper Grid Layouts</h3>
          <p>
            Choose from five specialized paper formats engineered for distinct academic and creative applications:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Single Ruled:</strong> Standard horizontal lined paper with red margin lines for homework and essays.</li>
            <li><strong>Double Ruled:</strong> Dual-line guide paper for children learning cursive writing and calligraphy practice.</li>
            <li><strong>Yellow Legal Pad:</strong> Classic legal pad format featuring a soft cream-yellow background and left margin rules.</li>
            <li><strong>Graph Grid:</strong> Precision square grid layout suited for mathematics equations, coordinate geometry, and engineering drafts.</li>
            <li><strong>Dot Grid:</strong> Faint dotted matrix (5mm spacing) providing subtle guidance for bullet journaling and sketchbooks.</li>
          </ul>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">3. Page Dimensions & Printer Paper Standards</h3>
        <p>
          Select the exact document size that matches your physical printer and regional standards:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div class="border border-hairline p-4 rounded bg-canvas-soft space-y-2">
            <h4 class="font-bold text-primary font-mono text-xs uppercase">A4 International Standard</h4>
            <p class="text-xs text-body leading-relaxed">
              210 x 297 mm (8.27 x 11.69 inches). The universal standard for school assignments, university lab files, and exams worldwide.
            </p>
          </div>
          <div class="border border-hairline p-4 rounded bg-canvas-soft space-y-2">
            <h4 class="font-bold text-primary font-mono text-xs uppercase">US Letter Standard</h4>
            <p class="text-xs text-body leading-relaxed">
              8.5 x 11 inches (215.9 x 279.4 mm). The primary paper standard utilized across the United States, Canada, and Mexico.
            </p>
          </div>
          <div class="border border-hairline p-4 rounded bg-canvas-soft space-y-2">
            <h4 class="font-bold text-primary font-mono text-xs uppercase">Legal Pad Standard</h4>
            <p class="text-xs text-body leading-relaxed">
              8.5 x 14 inches (215.9 x 355.6 mm). Extended vertical dimensions for legal briefs, executive notes, and long tables.
            </p>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">4. Printer Scaling Calibration (100% Actual Size)</h3>
        <p>
          To ensure generated rule lines match real physical rulers when printed:
        </p>
        <ol class="list-decimal pl-5 space-y-1.5">
          <li>In your PDF print dialog, set scaling to <strong>100% (Actual Size)</strong>. Do not use "Fit to Page" as it shrinks page dimensions.</li>
          <li>For fine handwriting, use 25px line height. For standard homework, use 30px line height.</li>
          <li>Select 300 DPI mode to ensure rule lines and margin borders render razor-sharp without blur.</li>
        </ol>
        <p>
          Once your paper template is generated, write on it using our <a href="/" class="text-link hover:underline font-semibold">text converter</a>, convert cursive notes with our <a href="/text-to-cursive" class="text-link hover:underline font-semibold font-mono">cursive converter</a>, or compare fonts on our <a href="/handwriting-font-preview" class="text-link hover:underline font-semibold font-mono">font preview catalog</a>.
        </p>
      </div>

      <!-- FAQ Accordions -->
      <div class="pt-8 border-t border-hairline space-y-6">
        <h3 class="text-lg font-bold tracking-tight text-primary uppercase font-mono text-center">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {PAPER_FAQS.map(faq => (
            <details class="group border border-hairline bg-canvas rounded-lg transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center font-mono font-semibold text-xs text-primary p-4 cursor-pointer select-none">
                <span>{faq.q}</span>
                <span class="text-mute group-open:rotate-180 transition-transform font-bold text-xs leading-none">v</span>
              </summary>
              <div class="px-4 pb-4 pt-0 text-xs text-body leading-relaxed border-t border-hairline/50 mt-1 pt-2">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>

    <RelatedTools current="/notebook-paper-generator" />

    <AdSlot slotId="footer-leaderboard" />
  </div>
</BaseLayout>
