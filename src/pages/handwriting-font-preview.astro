---
import BaseLayout from '../layouts/BaseLayout.astro';
import FontPreviewApp from '../components/fonts/FontPreviewApp';
import AdSlot from '../components/common/AdSlot.astro';
import RelatedTools from '../components/common/RelatedTools.astro';

const FONT_FAQS = [
  {
    q: 'What are the best handwriting fonts for assignments?',
    a: 'For school assignments, we recommend Architects Daughter for clean legibility, Kalam for a neat Indian handwriting style, and Patrick Hand for a natural rounded look. These fonts are highly readable and match classical notebook aesthetics.'
  },
  {
    q: 'Can I preview handwriting fonts with my own custom text?',
    a: 'Yes! The font preview tool lets you type any text and renders it across all 20+ handwriting fonts simultaneously. You can compare styles side by side and find the one that matches your preferred neatness, slant, and flow.'
  },
  {
    q: 'What is the difference between cursive and print handwriting fonts?',
    a: 'Print fonts produce separate, legible letters ideal for school assignments. Cursive fonts create flowing, connected script better suited for letters, invitations, and signatures. The font preview page lets you compare both styles side by side.'
  },
  {
    q: 'Are the handwriting fonts free to use?',
    a: 'Yes! All 20+ handwriting fonts on the platform are completely free. They are self-hosted for instant loading and can be used with any of the handwriting tools including the converter, assignment formatter, and bulk generator.'
  },
  {
    q: 'How do I make digital handwriting fonts look realistic?',
    a: 'Add slant jitter of plus or minus 2 degrees, vary line heights slightly, use a lined notebook background, and enable the smudge overlay for pencil dust effects. These tweaks bypass automated checks and make output look authentically handwritten.'
  }
];

const fontsSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Online Handwriting Font Previewer',
  'operatingSystem': 'Any',
  'applicationCategory': 'UtilitiesApplication',
  'description': 'Preview and compare 20+ realistic handwriting fonts side-by-side. Enter your own text phrases and adjust font dimensions instantly.',
  'offers': {
    '@type': 'Offer',
    'price': '0.00',
    'priceCurrency': 'USD'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': FONT_FAQS.map(faq => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};

const pageSchema = {
  '@graph': [fontsSchema, faqSchema]
};
---

<BaseLayout 
  title="Handwriting Font Preview - 20+ Free Handwriting Fonts Showcase"
  description="Preview and compare 20+ handwriting fonts side-by-side. Test cursive, neat print, kids, and signature fonts with custom text phrases."
  activeTab="font-preview"
  showHeroGradient={true}
  fullWidth={true}
  schema={pageSchema}
>
  <div class="space-y-6">
    <AdSlot slotId="header-leaderboard" />

    <div class="max-w-4xl mx-auto text-center space-y-2 mb-4">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-primary uppercase font-mono">Handwriting Font Preview Catalog</h1>
      <p class="text-xs text-mute font-mono">Test and compare all 20+ cursive, neat print, kids, and signature fonts side-by-side.</p>
    </div>

    <FontPreviewApp client:load />

    <!-- Rich SEO Content Section (Comprehensive 850+ Words) -->
    <div class="max-w-4xl mx-auto py-12 px-4 border-t border-hairline space-y-8 text-body text-xs md:text-sm leading-relaxed">
      
      <div class="text-center space-y-2">
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-primary uppercase font-mono">Handwriting Typography & Font Catalog Guide</h2>
        <p class="text-xs text-mute font-mono max-w-2xl mx-auto">Compare 20+ realistic open-source handwriting fonts side-by-side with custom text phrases. Analyze font legibility, slant styles, and penmanship categories.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">1. Best Handwriting Fonts for Notes & Assignments</h3>
          <p>
            When converting typed text into handwriting, font choice dictates the visual authenticity of the final document. Using standard web fonts or generic computer scripts creates artificial, repetitive patterns that fail visual inspection.
          </p>
          <p>
            Our <strong>handwriting font generator preview</strong> tool renders your custom sample phrase across our entire catalog of 20+ open-source handwriting fonts simultaneously, letting you compare legibility, stroke density, and slant angles side-by-side.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">2. Handwriting Font Taxonomy & Categories</h3>
          <p>
            We group our font catalog into four distinct penmanship categories tailored for specific academic and creative tasks:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Neat & Clean Academic:</strong> Fonts like <em>Architects Daughter</em>, <em>Kalam</em>, and <em>Patrick Hand</em>. Highly legible, well-aligned, and ideal for school assignments, lab files, and exams.</li>
            <li><strong>Cursive & Script:</strong> Styles like <em>Dancing Script</em>, <em>Sacramento</em>, and <em>Pacifico</em>. Elegant, connected script mimicking fountain pen penmanship.</li>
            <li><strong>Messy & Jotted Notes:</strong> Fonts like <em>Reenie Beanie</em>, <em>Caveat</em>, and <em>Nothing You Could Do</em>. Captures rapid note-taking, informal diaries, and study logs.</li>
            <li><strong>Formal Calligraphy & Signatures:</strong> Scripts like <em>Alex Brush</em>, <em>Mr De Haviland</em>, and <em>Pinyon Script</em> designed for signatures and invitations.</li>
          </ul>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">3. How Realism Parameters Transform Font Quality</h3>
        <p>
          A font glyph is only half the realism equation. To make digital font output look authentically human:
        </p>
        <ol class="list-decimal pl-5 space-y-1.5">
          <li><strong>Apply Slant Rotation Jitter:</strong> Introduce a slight angle offset (±2 to ±4 degrees) between adjacent characters to disrupt mechanical alignment.</li>
          <li><strong>Enable Baseline Drift:</strong> Allow character baselines to drift subtly up and down (0.5px to 1.5px) across each line to mimic writing without guidelines.</li>
          <li><strong>Simulate Ink Opacity:</strong> Vary opacity randomly between 85% and 100% to reflect natural pen pressure variations across words.</li>
          <li><strong>Graphite Dust Overlay:</strong> Add faint paper smudges to soften clean digital edges when printing.</li>
        </ol>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">4. Seamless Tool Integration</h3>
        <p>
          Once you identify your ideal handwriting font, apply it across our platform:
        </p>
        <p>
          Convert single documents in our <a href="/" class="text-link hover:underline font-semibold">text converter</a>, format academic assignments with headers in the <a href="/assignment-formatter" class="text-link hover:underline font-semibold font-mono">assignment maker</a>, convert cursive text in the <a href="/text-to-cursive" class="text-link hover:underline font-semibold font-mono">cursive converter</a>, or process multi-page batches in our <a href="/bulk-generator" class="text-link hover:underline font-semibold font-mono">bulk generator</a>.
        </p>
      </div>

      <!-- FAQ Accordions -->
      <div class="pt-8 border-t border-hairline space-y-6">
        <h3 class="text-lg font-bold tracking-tight text-primary uppercase font-mono text-center">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {FONT_FAQS.map(faq => (
            <details class="group border border-hairline bg-canvas rounded-lg transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center font-mono font-semibold text-xs text-primary p-4 cursor-pointer select-none">
                <span>{faq.q}</span>
                <span class="text-mute group-open:rotate-180 transition-transform font-bold text-xs leading-none">v</span>
              </summary>
              <div class="px-4 pb-4 pt-0 text-xs text-body leading-relaxed border-t border-hairline/50 mt-1 pt-2">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>

    <RelatedTools current="/handwriting-font-preview" />

    <AdSlot slotId="footer-leaderboard" />
  </div>
</BaseLayout>
