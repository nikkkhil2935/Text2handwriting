---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignatureApp from '../components/signature/SignatureApp';
import AdSlot from '../components/common/AdSlot.astro';
import RelatedTools from '../components/common/RelatedTools.astro';

const SIGNATURE_FAQS = [
  {
    q: 'How do I create a handwritten signature online free?',
    a: 'Type your name or initials into the signature generator. It instantly renders your text in professional cursive script fonts. You can adjust the font, size, slant, and ink color, then download the signature as a transparent PNG or SVG file.'
  },
  {
    q: 'Can I type my name and generate a signature?',
    a: 'Yes! Switch to the "Type" mode, enter your full name or initials, and browse through multiple cursive signature fonts. The generator produces a polished signature image you can use on documents, invoices, and contracts.'
  },
  {
    q: 'What makes a signature look realistic?',
    a: 'A realistic signature has natural slant (5-10 degrees forward tilt), varied stroke thickness, slight baseline wobble, and ink color that matches real pen output. Our generator applies these variations automatically for authentic results.'
  },
  {
    q: 'Is my signature data stored on your servers?',
    a: 'No. The signature generator runs entirely in your browser using client-side JavaScript. Your typed text, drawn strokes, and exported images are never transmitted to any server. Your personal data stays completely private.'
  },
  {
    q: 'What file formats can I download my signature in?',
    a: 'You can download your signature as a transparent PNG (ideal for overlaying on documents) or as a vector SVG (ideal for scaling to any size without losing quality). Both formats are available for free.'
  }
];

const signatureSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Online Signature Generator',
  'operatingSystem': 'Any',
  'applicationCategory': 'UtilitiesApplication',
  'description': 'Create custom handwritten electronic signatures. Type your name to auto-render script styles or draw signatures freehand. Export as transparent PNG or vector SVG.',
  'offers': {
    '@type': 'Offer',
    'price': '0.00',
    'priceCurrency': 'USD'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': SIGNATURE_FAQS.map(faq => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};

const pageSchema = {
  '@graph': [signatureSchema, faqSchema]
};
---

<BaseLayout 
  title="Signature Generator - Free Electronic Signature Maker from Text"
  description="Create handwritten signatures from text. Type your name, select cursive script styles, or draw freehand. Export transparent PNG or vector SVG."
  activeTab="signature"
  showHeroGradient={true}
  fullWidth={true}
  schema={pageSchema}
>
  <div class="space-y-6">
    <AdSlot slotId="header-leaderboard" />

    <div class="max-w-4xl mx-auto text-center space-y-2 mb-4">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-primary uppercase font-mono">Signature Generator from Text</h1>
      <p class="text-xs text-mute font-mono">Type your name to create a professional handwritten signature. Download as PNG or SVG instantly.</p>
    </div>

    <SignatureApp client:load />

    <!-- Rich SEO Content Section (Comprehensive 850+ Words) -->
    <div class="max-w-4xl mx-auto py-12 px-4 border-t border-hairline space-y-8 text-body text-xs md:text-sm leading-relaxed">
      
      <div class="text-center space-y-2">
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-primary uppercase font-mono">Electronic Signature & Digital Document Guide</h2>
        <p class="text-xs text-mute font-mono max-w-2xl mx-auto">Create professional handwritten e-signatures from typed text or freehand drawing. Export high-resolution transparent PNG and vector SVG files.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">1. Create Handwritten Signature Online Free</h3>
          <p>
            An electronic signature is a digital representation of a person's handwritten mark used to authorize contracts, sign PDFs, approve invoices, or verify business agreements online. As remote workflow platforms proliferate, maintaining a clean, professional e-signature is an essential professional asset.
          </p>
          <p>
            Our free <strong>signature generator from text</strong> offers two distinct creation modes: converting typed names into elegant calligraphy script styles, or drawing your signature freehand using your mouse, trackpad, or stylus.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">2. Type Your Name & Generate a Signature</h3>
          <p>
            Designing a signature requires balancing legibility with personal expression. Follow these professional styling guidelines:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Select the Right Font:</strong> Use flowing script fonts like <em>Alex Brush</em>, <em>Mr De Haviland</em>, or <em>Pinyon Script</em>.</li>
            <li><strong>Ink Color Calibration:</strong> Royal blue and rich dark gray represent standard ink colors for business correspondence and contract overlays.</li>
            <li><strong>Angle Slant:</strong> Add a forward tilt (5 to 10 degrees) to give the signature dynamic, fluid energy.</li>
            <li><strong>Stroke Weight:</strong> Ensure pen thickness remains visible without pixelation when inserted into digital PDFs.</li>
          </ul>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">3. Type to Signature vs Draw to Signature</h3>
        <p>
          Both signature generation methods offer specific advantages:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="border border-hairline p-4 rounded bg-canvas-soft space-y-2">
            <h4 class="font-bold text-primary font-mono text-xs uppercase">Type to Signature Mode</h4>
            <p class="text-xs text-body leading-relaxed">
              Type your initials or full name. The generator instantly renders your input using specialized script fonts. You can customize size, slant, and ink color. Ideal for users seeking clean, perfectly balanced signature aesthetics.
            </p>
          </div>
          <div class="border border-hairline p-4 rounded bg-canvas-soft space-y-2">
            <h4 class="font-bold text-primary font-mono text-xs uppercase">Draw to Signature Mode</h4>
            <p class="text-xs text-body leading-relaxed">
              Write directly on the interactive HTML5 sketch canvas with a stylus or finger. The tool captures your strokes as clean vector paths, producing a 100% unique replica of your manual signature.
            </p>
          </div>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">4. Transparent PNG & Vector SVG Export Formats</h3>
        <p>
          Exporting transparent images allows seamless signature overlays onto PDF contracts, Word documents, or email headers:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li><strong>Transparent PNG:</strong> Renders with absolute alpha-channel transparency, making it easy to drop onto document signature lines without white background boxes.</li>
          <li><strong>Scalable Vector SVG:</strong> Outputs vector path data, allowing infinite scaling without quality degradation or pixelation.</li>
        </ul>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">5. Client-Side Privacy Isolation</h3>
        <p>
          Because signatures represent sensitive personal identity data, our signature maker operates <strong>100% client-side</strong>. Your typed name, mouse strokes, and exported images are processed locally within your browser sandbox and are never uploaded to external servers.
        </p>
        <p>
          Need full handwritten pages alongside your signature? Use the main <a href="/" class="text-link hover:underline font-semibold">text converter</a>. For printable paper grids, try the <a href="/notebook-paper-generator" class="text-link hover:underline font-semibold font-mono">notebook paper maker</a>, or convert long files in batch with the <a href="/bulk-generator" class="text-link hover:underline font-semibold font-mono">bulk generator</a>.
        </p>
      </div>

      <!-- FAQ Accordions -->
      <div class="pt-8 border-t border-hairline space-y-6">
        <h3 class="text-lg font-bold tracking-tight text-primary uppercase font-mono text-center">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {SIGNATURE_FAQS.map(faq => (
            <details class="group border border-hairline bg-canvas rounded-lg transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center font-mono font-semibold text-xs text-primary p-4 cursor-pointer select-none">
                <span>{faq.q}</span>
                <span class="text-mute group-open:rotate-180 transition-transform font-bold text-xs leading-none">v</span>
              </summary>
              <div class="px-4 pb-4 pt-0 text-xs text-body leading-relaxed border-t border-hairline/50 mt-1 pt-2">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>

    <RelatedTools current="/signature-generator" />

    <AdSlot slotId="footer-leaderboard" />
  </div>
</BaseLayout>
