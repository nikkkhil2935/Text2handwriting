---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterApp from '../components/converter/ConverterApp';
import AdSlot from '../components/common/AdSlot.astro';
import RelatedTools from '../components/common/RelatedTools.astro';

const ASSIGNMENT_FAQS = [
  {
    q: 'How do I make a typed assignment look handwritten with name and date?',
    a: 'Type your assignment content into the editor, then open the Headers panel. Enable the Assignment Cover Header and fill in your name, date, subject, and other fields. The tool renders these at the top of every page in handwriting style along with your main content.'
  },
  {
    q: 'What is the best font for school assignment handwriting?',
    a: 'For school assignments, we recommend Architects Daughter for a clean, legible print style. Kalam and Patrick Hand are also excellent choices. Avoid complex cursive fonts for academic work as teachers need to read your content easily.'
  },
  {
    q: 'Can I add page numbers to my handwritten assignment?',
    a: 'Yes! Open the Headers panel and configure the footer format. Use the pattern "Page {page} of {pages}" to automatically number every page. This keeps multi-page assignments organized and professional.'
  },
  {
    q: 'How do I set up lined margin layouts for homework?',
    a: 'Select the A4 Notebook Ruled paper preset, enable the red left margin line, and set your line spacing to match your font size (typically 30px for standard ruled sheets). The alignment ensures your text sits naturally on the guidelines.'
  },
  {
    q: 'Can I download my handwritten assignment as a print-ready PDF?',
    a: 'Yes. Set the export quality to 300 DPI (3x Quality) and select PDF as the format. This produces sharp, print-ready output that looks authentic when printed on real paper. Choose A4 or Letter size based on your school requirements.'
  }
];

const assignmentSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Online Homework & Assignment Formatter',
  'operatingSystem': 'Any',
  'applicationCategory': 'EducationalApplication',
  'description': 'Convert typed notes and homework sheets into realistic handwritten school assignments. Includes margin styling, paper line alignment, and multi-page exports.',
  'offers': {
    '@type': 'Offer',
    'price': '0.00',
    'priceCurrency': 'USD'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': ASSIGNMENT_FAQS.map(faq => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};

const pageSchema = {
  '@graph': [assignmentSchema, faqSchema]
};
---

<BaseLayout 
  title="Assignment Handwriting Maker - Convert Homework to Handwriting"
  description="Make typed assignments look handwritten with student name and date. Free online assignment formatter with lined margins and high-DPI PDF export."
  activeTab="assignment"
  showHeroGradient={true}
  fullWidth={true}
  schema={pageSchema}
>
  <div class="space-y-6">
    <AdSlot slotId="header-leaderboard" />

    <div class="max-w-4xl mx-auto text-center space-y-2 mb-4">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-primary uppercase font-mono">Assignment Handwriting Maker</h1>
      <p class="text-xs text-mute font-mono">Convert your homework text files into realistic, neat handwritten assignment sheets with headers and dates.</p>
    </div>

    <ConverterApp client:load defaultFont="Architects Daughter" defaultPaper="a4-notebook" isAssignmentMode={true} />

    <!-- Rich SEO Content Section (Comprehensive 850+ Words) -->
    <div class="max-w-4xl mx-auto py-12 px-4 border-t border-hairline space-y-8 text-body text-xs md:text-sm leading-relaxed">
      
      <div class="text-center space-y-2">
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-primary uppercase font-mono">Academic Assignment Handwriting Guide</h2>
        <p class="text-xs text-mute font-mono max-w-2xl mx-auto">Learn how to convert typed essays, lab files, and homework into presentation-grade handwritten assignments formatted with student headers.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">1. Make Typed Assignments Look Handwritten with Headers</h3>
          <p>
            Students across schools, colleges, and technical universities are frequently tasked with writing long practical lab records, project reports, and homework assignments by hand. Our <strong>assignment handwriting maker</strong> simplifies this by enabling you to draft text digitally while outputting realistic handwritten pages complete with authentic student headers.
          </p>
          <p>
            By enabling the Assignment Header panel, you can insert your Full Name, Subject Code, Submission Date, Teacher Name, and Roll Number directly at the top margin of every page, matching institutional presentation standards.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">2. Selecting the Best Academic Handwriting Font</h3>
          <p>
            When submitting school assignments, legibility is paramount. Using decorative or overly slanted cursive fonts makes homework difficult for teachers to read and grade. We recommend these clean print font styles:
          </p>
          <ul class="list-disc pl-5 space-y-1">
            <li><strong>Architects Daughter:</strong> The standard academic printing font. Highly legible, well-proportioned, and replicates clean student penmanship.</li>
            <li><strong>Kalam:</strong> A natural handwriting style with subtle character variations. Excellent for both English and bilingual content.</li>
            <li><strong>Patrick Hand:</strong> A friendly, rounded font ideal for junior school notes and literature homework.</li>
            <li><strong>Amita:</strong> Optimized for assignments requiring both English and Devanagari (Hindi) scripts.</li>
          </ul>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">3. Formatting Guidelines for Ruled Notebook Papers</h3>
        <p>
          To make digital output look completely handwritten, precise alignment to notebook guidelines is required:
        </p>
        <ol class="list-decimal pl-5 space-y-2">
          <li><strong>Rule Line Alignment:</strong> Select <em>A4 Notebook Ruled</em> and adjust line height (typically 30px) so your text sits naturally on the horizontal ruling lines without floating or overlapping.</li>
          <li><strong>Red Left Margin Line:</strong> Enable the red vertical margin line. This aligns line origins and leaves space for question numbers and evaluation marks.</li>
          <li><strong>Realism Parameters:</strong> Set character slant variation to ±2 degrees, baseline drift to 1.0px, and opacity jitter between 85% and 100% to simulate pen pressure variations.</li>
          <li><strong>Dynamic Page Footers:</strong> Configure footers formatted as <code>Page &#123;page&#125; of &#123;pages&#125;</code> to maintain pagination across multi-page files.</li>
        </ol>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">4. High-DPI PDF Exports & Physical Printing Setup</h3>
        <p>
          Exporting at standard screen resolution produces pixelated lines when printed on paper. Always select <strong>300 DPI (3x Quality)</strong> and export as a PDF document. High-DPI exports preserve natural ink textures, fine rule lines, and subtle character jitter.
        </p>
        <p>
          For multi-document batches, use the <a href="/bulk-generator" class="text-link hover:underline font-semibold">bulk generator</a>. To compare font options side-by-side, visit the <a href="/handwriting-font-preview" class="text-link hover:underline font-semibold font-mono">font preview catalog</a>. For digital signatures on cover sheets, use the <a href="/signature-generator" class="text-link hover:underline font-semibold font-mono">signature generator</a>.
        </p>
      </div>

      <!-- FAQ Accordions -->
      <div class="pt-8 border-t border-hairline space-y-6">
        <h3 class="text-lg font-bold tracking-tight text-primary uppercase font-mono text-center">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {ASSIGNMENT_FAQS.map(faq => (
            <details class="group border border-hairline bg-canvas rounded-lg transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center font-mono font-semibold text-xs text-primary p-4 cursor-pointer select-none">
                <span>{faq.q}</span>
                <span class="text-mute group-open:rotate-180 transition-transform font-bold text-xs leading-none">v</span>
              </summary>
              <div class="px-4 pb-4 pt-0 text-xs text-body leading-relaxed border-t border-hairline/50 mt-1 pt-2">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>

    <RelatedTools current="/assignment-formatter" />

    <AdSlot slotId="footer-leaderboard" />
  </div>
</BaseLayout>
