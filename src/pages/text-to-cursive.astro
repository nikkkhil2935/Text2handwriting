---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConverterApp from '../components/converter/ConverterApp';
import AdSlot from '../components/common/AdSlot.astro';
import RelatedTools from '../components/common/RelatedTools.astro';

const CURSIVE_FAQS = [
  {
    q: 'How do I convert typed text to cursive handwriting online?',
    a: 'Simply paste or type your text into the editor on this page. The tool automatically loads cursive fonts like Dancing Script and Pacifico. You can adjust slant, letter spacing, and baseline drift to make the cursive look natural, then download as PNG or PDF.'
  },
  {
    q: 'What is the best cursive font for handwriting practice?',
    a: 'For practice, we recommend Dancing Script for flowing connected letters, or Sacramento for a more formal cursive style. Great Vibes and Yellowtail are also excellent choices for mimicking real fountain pen cursive writing.'
  },
  {
    q: 'Can kids use this cursive writing converter?',
    a: 'Yes! Our cursive handwriting generator is perfect for kids learning cursive. Use the double-ruled paper template for guided practice, and choose simpler cursive fonts like Cedarville Cursive or Homemade Apple that are easier to read and replicate.'
  },
  {
    q: 'How do I make cursive letters connect naturally?',
    a: 'To connect cursive letters naturally, reduce the letter spacing to between -0.5px and -1.5px to pull characters closer. Use the fountain pen ink texture to fill small gaps between letters. Also reduce vertical jitter so characters align on the same baseline for smooth ligatures.'
  },
  {
    q: 'Is the cursive writing converter free to use?',
    a: 'Yes, the text to cursive converter is completely free with no watermarks, sign-ups, or usage limits. You can generate unlimited cursive handwriting images and PDFs directly in your browser.'
  }
];

const cursiveSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': 'Text to Cursive Writing Converter',
  'operatingSystem': 'Any',
  'applicationCategory': 'EducationalApplication',
  'description': 'Convert typed text into realistic cursive handwriting online. Choose from 8+ cursive fonts, adjust slant and letter spacing, and download as printable PNG or PDF.',
  'offers': {
    '@type': 'Offer',
    'price': '0.00',
    'priceCurrency': 'USD'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': CURSIVE_FAQS.map(faq => ({
    '@type': 'Question',
    'name': faq.q,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.a
    }
  }))
};

const pageSchema = {
  '@graph': [cursiveSchema, faqSchema]
};
---

<BaseLayout 
  title="Text to Cursive Converter - Free Cursive Handwriting Generator"
  description="Convert typed text to cursive handwriting online. Select from 8+ cursive fonts, adjust slant and ligature spacing, and download printable PNG or PDF."
  activeTab="cursive"
  showHeroGradient={true}
  fullWidth={true}
  schema={pageSchema}
>
  <div class="space-y-6">
    <AdSlot slotId="header-leaderboard" />

    <div class="max-w-4xl mx-auto text-center space-y-2 mb-4">
      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-primary uppercase font-mono">Text to Cursive Writing Converter</h1>
      <p class="text-xs text-mute font-mono">Convert typed text into flowing cursive handwriting. Choose fonts, adjust slant, and download as PNG or PDF.</p>
    </div>

    <ConverterApp client:load defaultFont="Dancing Script" defaultPaper="single-ruled" />

    <!-- Rich SEO Content Section (Comprehensive 850+ Words) -->
    <div class="max-w-4xl mx-auto py-12 px-4 border-t border-hairline space-y-8 text-body text-xs md:text-sm leading-relaxed">
      
      <div class="text-center space-y-2">
        <h2 class="text-xl md:text-2xl font-bold tracking-tight text-primary uppercase font-mono">The Ultimate Cursive Handwriting Guide</h2>
        <p class="text-xs text-mute font-mono max-w-2xl mx-auto">Master digital cursive script conversion, ligature connections, ink bleed textures, and printable handwriting practice worksheets.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">1. Convert Typed Text to Cursive Handwriting Online</h3>
          <p>
            Cursive handwriting represents a timeless artform, combining continuous letter ligatures and flowing strokes to create elegant text. Our <strong>text to cursive writing converter</strong> allows you to paste typed prose and instantly render it into natural cursive script. Whether you are drafting personal letters, crafting wedding invitations, or generating study notes, our engine renders realistic cursive directly in your browser.
          </p>
          <p>
            Unlike static font renderers that repeat identical character shapes, our converter injects per-character slant offsets, baseline drift, and ink pressure simulation to give cursive text the authentic look of manual penmanship.
          </p>
        </div>

        <div class="space-y-4">
          <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">2. Cursive Handwriting Generator for Kids & Practice</h3>
          <p>
            Learning cursive is a vital fine-motor development exercise for young students. Our <strong>cursive handwriting generator for kids</strong> includes specialized double-ruled paper templates featuring top, middle, and baseline guide lines.
          </p>
          <p>
            Parents and teachers can generate customized practice sheets by typing vocabulary words or sentence lists, choosing kid-friendly cursive fonts (such as <em>Cedarville Cursive</em> or <em>Homemade Apple</em>), and exporting high-resolution PDFs for classroom printing.
          </p>
        </div>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">3. How to Connect Cursive Ligatures Dynamically</h3>
        <p>
          A common flaw in digital handwriting fonts is that cursive loops do not touch correctly, creating visible gaps between letters. To achieve continuous connected script:
        </p>
        <ol class="list-decimal pl-5 space-y-1.5">
          <li><strong>Letter Spacing Adjustment:</strong> Set letter-spacing to a subtle negative offset (between <code>-0.5px</code> and <code>-1.5px</code>) to draw glyphs closer together.</li>
          <li><strong>Fountain Pen Texture:</strong> Choose <em>Fountain Blue</em> or <em>Fountain Black</em> ink presets. These include a subtle micro-bleed texture that fills microscopic vector gaps between letters.</li>
          <li><strong>Baseline Stabilization:</strong> Lower the vertical jitter parameter to under <code>0.8px</code> so glyph baselines align precisely, enabling cursive tails to join naturally.</li>
        </ol>
      </div>

      <div class="space-y-4">
        <h3 class="text-base font-semibold text-primary font-mono uppercase tracking-tight">4. High-Res PNG & PDF Cursive Exports</h3>
        <p>
          Export your rendered cursive sheets in high-resolution PNG format at 300 DPI for graphics projects, or as multi-page vector-embedded PDFs for printing. All rendering happens completely client-side in your browser, guaranteeing total privacy.
        </p>
        <p>
          For general print handwriting, use the main <a href="/" class="text-link hover:underline font-semibold">text converter</a>. To generate formal electronic signatures, try the <a href="/signature-generator" class="text-link hover:underline font-semibold font-mono">signature generator</a>, or compare cursive fonts side-by-side on our <a href="/handwriting-font-preview" class="text-link hover:underline font-semibold font-mono">font preview catalog</a>.
        </p>
      </div>

      <!-- FAQ Accordions -->
      <div class="pt-8 border-t border-hairline space-y-6">
        <h3 class="text-lg font-bold tracking-tight text-primary uppercase font-mono text-center">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {CURSIVE_FAQS.map(faq => (
            <details class="group border border-hairline bg-canvas rounded-lg transition-all [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex justify-between items-center font-mono font-semibold text-xs text-primary p-4 cursor-pointer select-none">
                <span>{faq.q}</span>
                <span class="text-mute group-open:rotate-180 transition-transform font-bold text-xs leading-none">v</span>
              </summary>
              <div class="px-4 pb-4 pt-0 text-xs text-body leading-relaxed border-t border-hairline/50 mt-1 pt-2">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>

    </div>

    <RelatedTools current="/text-to-cursive" />

    <AdSlot slotId="footer-leaderboard" />
  </div>
</BaseLayout>
