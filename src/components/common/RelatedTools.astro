---
/**
 * RelatedTools.astro
 * Displays a curated grid of internal backlinks to related tools.
 * Used across all tool pages for SEO and cross-navigation.
 */

interface Tool {
  href: string;
  label: string;
  description: string;
  iconType: 'converter' | 'bulk' | 'assignment' | 'signature' | 'notebook' | 'cursive' | 'fonts';
  badge?: string;
}

interface Props {
  /** The slug of the current page (excluded from the grid) */
  current: string;
  /** Optional override heading */
  heading?: string;
}

const { current, heading = 'Explore More Handwriting Tools' } = Astro.props;

const ALL_TOOLS: Tool[] = [
  {
    href: '/',
    label: 'Text to Handwriting',
    description: 'Convert any typed text into realistic, print-ready handwriting with 20+ fonts.',
    iconType: 'converter',
    badge: 'Most Popular',
  },
  {
    href: '/bulk-generator',
    label: 'Bulk Generator',
    description: 'Convert hundreds of pages at once via CSV or delimiter-separated text.',
    iconType: 'bulk',
  },
  {
    href: '/assignment-formatter',
    label: 'Assignment Formatter',
    description: 'Format typed homework as neat handwritten pages with name, date & headers.',
    iconType: 'assignment',
  },
  {
    href: '/signature-generator',
    label: 'Signature Generator',
    description: 'Create professional cursive signatures from text or by drawing freehand.',
    iconType: 'signature',
  },
  {
    href: '/notebook-paper-generator',
    label: 'Notebook Paper Generator',
    description: 'Generate custom ruled, graph, dot-grid, and legal pad paper as PDFs.',
    iconType: 'notebook',
  },
  {
    href: '/text-to-cursive',
    label: 'Cursive Converter',
    description: 'Transform any text into flowing cursive Unicode script instantly.',
    iconType: 'cursive',
  },
  {
    href: '/handwriting-font-preview',
    label: 'Font Showcase',
    description: 'Preview all 20+ handwriting fonts side by side before you generate.',
    iconType: 'fonts',
  },
];

// Exclude the current page from the backlinks list
const tools = ALL_TOOLS.filter(t => t.href !== current);
---

<section class="max-w-4xl mx-auto py-12 px-4 border-t border-hairline">
  <h2 class="text-sm font-mono font-bold uppercase tracking-widest text-primary text-center mb-1">
    {heading}
  </h2>
  <p class="text-center text-xs text-mute font-mono mb-8">
    Free online handwriting tools - no sign-up, all client-side.
  </p>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
    {tools.map(tool => (
      <a
        href={tool.href}
        class="group relative flex flex-col gap-1.5 border border-hairline bg-canvas hover:border-hairline-strong hover:bg-canvas-soft rounded-xl p-4 transition-all duration-200 hover:shadow-md hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
        aria-label={`Go to ${tool.label}`}
      >
        {tool.badge && (
          <span class="absolute top-2 right-2 text-[9px] font-mono font-semibold uppercase tracking-wider text-link border border-link/30 bg-link/5 rounded-full px-1.5 py-0.5 leading-none">
            {tool.badge}
          </span>
        )}
        <span class="flex h-7 w-7 items-center justify-center rounded border border-hairline bg-canvas-soft text-primary select-none" aria-hidden="true">
          {tool.iconType === 'converter' && (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          )}
          {tool.iconType === 'bulk' && (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
          )}
          {tool.iconType === 'assignment' && (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          )}
          {tool.iconType === 'signature' && (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          )}
          {tool.iconType === 'notebook' && (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/><path d="M6 14h10"/></svg>
          )}
          {tool.iconType === 'cursive' && (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          )}
          {tool.iconType === 'fonts' && (
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>
          )}
        </span>
        <span class="text-xs font-semibold font-mono text-primary group-hover:text-link transition-colors leading-snug mt-0.5">
          {tool.label}
        </span>
        <span class="text-[11px] text-mute leading-relaxed line-clamp-2">
          {tool.description}
        </span>
        <span class="text-[10px] font-mono text-link mt-auto pt-1 opacity-0 group-hover:opacity-100 transition-opacity inline-flex items-center gap-1">
          <span>Open</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </span>
      </a>
    ))}
  </div>
</section>
