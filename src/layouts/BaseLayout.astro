---
import '../styles/global.css';
import CookieConsent from '../components/common/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, any>;
  showHeroGradient?: boolean;
  activeTab?: string;
  fullWidth?: boolean;
}

const siteUrl = 'https://texttohandwriting.me';
const cleanPath = Astro.url.pathname.replace(/\/+$/, '');
const finalCanonicalUrl = Astro.props.canonicalUrl || (cleanPath === '' ? `${siteUrl}/` : `${siteUrl}${cleanPath}`);

const {
  title,
  description,
  canonicalUrl = finalCanonicalUrl,
  ogImage = '/og-image.png',
  ogType = 'website',
  schema,
  showHeroGradient = false,
  activeTab = '',
  fullWidth = false
} = Astro.props;

// Build breadcrumb list schema automatically
const urlPaths = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = urlPaths.map((path, idx) => ({
  '@type': 'ListItem',
  'position': idx + 1,
  'name': path.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
  'item': `${siteUrl}/${urlPaths.slice(0, idx + 1).join('/')}`
}));

const breadcrumbSchema = urlPaths.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbItems
} : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Text to Handwriting',
  'url': siteUrl
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Text to Handwriting',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) — deferred until cookie consent is given. The
         AdSense SDK is NOT loaded here: ad-slot components load it lazily,
         consent-gated, only on pages that actually render an ad unit. -->
    <script is:inline>
      // Analytics stay off until the user accepts in the cookie banner.
      // The dataLayer/gtag stub remains active so any gtag() calls are queued and
      // replayed once the real script loads (standard GA behavior).
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      window.__loadAnalytics = function () {
        if (window.__analyticsLoaded) return;
        window.__analyticsLoaded = true;

        var gtagScript = document.createElement('script');
        gtagScript.async = true;
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-TEY89MX99W';
        document.head.appendChild(gtagScript);
        gtag('js', new Date());
        gtag('config', 'G-TEY89MX99W');
      };

      (function () {
        try {
          if (localStorage.getItem('cookie-consent') === 'accepted') {
            window.__loadAnalytics();
          }
        } catch (e) {
          // localStorage unavailable — keep third-party scripts off
        }
      })();
    </script>

    <!-- Theme init — runs before first paint to avoid a flash. Dark mode is
         driven by the .dark class on <html>, set from the system preference by
         default or a persisted choice in localStorage. -->
    <script is:inline>
      (function () {
        var dark = false;
        try {
          var stored = localStorage.getItem('theme');
          dark = stored === 'dark' || (!stored && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        } catch (e) {
          dark = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Text to Handwriting" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="msvalidate.01" content="535FF23B7A4B19C33E26225541987ADC" />

    <!-- Google AdSense account declaration (no scripts load until consent) -->
    <meta name="google-adsense-account" content="ca-pub-9725731987817847" />

    <!-- Google Fonts Preconnect and Prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet" />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, siteUrl)} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    )}

  </head>
  <body class="relative flex flex-col min-h-screen bg-canvas-soft text-ink font-sans selection:bg-primary selection:text-on-primary antialiased">
    
    <!-- Background Gradient (Vercel-like) -->
    {showHeroGradient && (
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1400px] h-[550px] overflow-hidden pointer-events-none z-0 opacity-40 dark:opacity-20 transition-opacity">
        <div class="absolute top-[-10%] left-[-10%] w-[120%] h-[120%] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-300 via-violet-300 to-transparent blur-[120px] dark:from-blue-900 dark:via-purple-900"></div>
      </div>
    )}

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 w-full bg-canvas/85 backdrop-blur-md border-b border-hairline py-3 px-3 sm:px-4 md:px-8 flex items-center justify-between transition-colors shadow-xs">
      <div class="flex items-center space-x-6 lg:space-x-8">
        <a href="/" class="group flex items-center space-x-2.5 text-primary hover:opacity-90 font-mono tracking-tight font-bold text-base transition-all">
          <div class="w-8 h-8 rounded-lg bg-primary text-on-primary flex items-center justify-center shadow-xs transition-transform group-hover:scale-105 border border-hairline">
            <svg class="w-4 h-4 text-on-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="leading-none text-sm font-bold tracking-tight">Text to Handwriting</span>
            <span class="text-[9px] text-mute font-mono font-medium tracking-wide mt-0.5">Realism Studio</span>
          </div>
        </a>

        <!-- Desktop Navigation Bar -->
        <nav class="hidden lg:flex items-center space-x-1 text-xs font-mono font-medium">
          <!-- Tools Dropdown -->
          <div class="relative group">
            <button
              id="tools-dropdown-btn"
              type="button"
              class={`px-3 py-1.5 rounded-full transition-colors flex items-center gap-1.5 cursor-pointer ${
                ['home', 'bulk', 'assignment', 'signature', 'notebook', 'cursive'].includes(activeTab || '')
                  ? 'text-primary bg-canvas-soft-2 font-semibold border border-hairline'
                  : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'
              }`}
              aria-expanded="false"
              aria-haspopup="true"
            >
              <span>Handwriting Tools</span>
              <svg class="w-3.5 h-3.5 text-mute transition-transform group-hover:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </button>

            <!-- Dropdown Card -->
            <div
              id="tools-dropdown-menu"
              class="absolute left-0 top-full pt-2 w-72 invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto"
            >
              <div class="bg-canvas/95 backdrop-blur-md border border-hairline rounded-xl p-2 shadow-xl flex flex-col gap-1">
                <a href="/" class={`flex items-start gap-3 p-2 rounded-lg transition-colors hover:bg-canvas-soft ${activeTab === 'home' ? 'bg-canvas-soft text-primary' : 'text-body hover:text-primary'}`}>
                  <div class="w-7 h-7 rounded bg-blue-50 dark:bg-blue-950/40 text-link flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-primary">Text Converter</div>
                    <div class="text-[10px] text-mute leading-snug">Convert text into authentic handwritten notes</div>
                  </div>
                </a>
                <a href="/bulk-generator" class={`flex items-start gap-3 p-2 rounded-lg transition-colors hover:bg-canvas-soft ${activeTab === 'bulk' ? 'bg-canvas-soft text-primary' : 'text-body hover:text-primary'}`}>
                  <div class="w-7 h-7 rounded bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-primary">Bulk Generator</div>
                    <div class="text-[10px] text-mute leading-snug">Generate multiple chapters or CSV rows in batch</div>
                  </div>
                </a>
                <a href="/assignment-formatter" class={`flex items-start gap-3 p-2 rounded-lg transition-colors hover:bg-canvas-soft ${activeTab === 'assignment' ? 'bg-canvas-soft text-primary' : 'text-body hover:text-primary'}`}>
                  <div class="w-7 h-7 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-primary">Assignment Maker</div>
                    <div class="text-[10px] text-mute leading-snug">Pre-formatted student headers, roll no & dates</div>
                  </div>
                </a>
                <a href="/signature-generator" class={`flex items-start gap-3 p-2 rounded-lg transition-colors hover:bg-canvas-soft ${activeTab === 'signature' ? 'bg-canvas-soft text-primary' : 'text-body hover:text-primary'}`}>
                  <div class="w-7 h-7 rounded bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-primary">Signature Maker</div>
                    <div class="text-[10px] text-mute leading-snug">Type or draw cursive signatures with vector SVG</div>
                  </div>
                </a>
                <a href="/notebook-paper-generator" class={`flex items-start gap-3 p-2 rounded-lg transition-colors hover:bg-canvas-soft ${activeTab === 'notebook' ? 'bg-canvas-soft text-primary' : 'text-body hover:text-primary'}`}>
                  <div class="w-7 h-7 rounded bg-rose-50 dark:bg-rose-950/40 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M6 6h10"/><path d="M6 10h10"/><path d="M6 14h10"/></svg>
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-primary">Notebook Paper</div>
                    <div class="text-[10px] text-mute leading-snug">Create custom ruled, graph & legal pad PDFs</div>
                  </div>
                </a>
                <a href="/text-to-cursive" class={`flex items-start gap-3 p-2 rounded-lg transition-colors hover:bg-canvas-soft ${activeTab === 'cursive' ? 'bg-canvas-soft text-primary' : 'text-body hover:text-primary'}`}>
                  <div class="w-7 h-7 rounded bg-cyan-50 dark:bg-cyan-950/40 text-cyan-600 dark:text-cyan-400 flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
                  </div>
                  <div>
                    <div class="font-semibold text-xs text-primary">Cursive Converter</div>
                    <div class="text-[10px] text-mute leading-snug">Elegant cursive script with ligature spacing</div>
                  </div>
                </a>
              </div>
            </div>
          </div>

          <a href="/handwriting-font-preview" class={`px-3 py-1.5 rounded-full transition-colors ${activeTab === 'font-preview' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Fonts</a>
          <a href="/blog" class={`px-3 py-1.5 rounded-full transition-colors ${activeTab === 'blog' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Blog</a>
          <a href="/faq" class={`px-3 py-1.5 rounded-full transition-colors ${activeTab === 'faq' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>FAQ</a>
          <a href="/about-us" class={`px-3 py-1.5 rounded-full transition-colors ${activeTab === 'about' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>About</a>
        </nav>
      </div>

      <div class="flex items-center space-x-3">
        <!-- Quick Action CTA -->
        <a
          href="/"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-[11px] font-mono font-bold rounded-full bg-primary text-on-primary hover:opacity-90 transition-all shadow-xs cursor-pointer uppercase tracking-wider"
        >
          <span>Convert</span>
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </a>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="p-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body hover:text-primary cursor-pointer transition-all hover:scale-105 active:scale-95"
          aria-label="Toggle dark mode"
          title="Toggle dark mode"
        >
          <svg class="theme-icon-moon w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <svg class="theme-icon-sun w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        </button>

        <!-- Mobile Menu Trigger -->
        <button
          id="mobile-menu-toggle"
          class="lg:hidden p-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body hover:text-primary cursor-pointer transition-colors"
          aria-label="Open navigation menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
      </div>
    </header>

    <!-- Mobile Drawer Overlay Menu -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-canvas-soft/98 backdrop-blur-lg translate-x-full transition-transform duration-300 flex flex-col p-6 lg:hidden">
      <div class="flex items-center justify-between pb-4 border-b border-hairline">
        <span class="font-mono font-bold tracking-tight text-sm text-primary flex items-center gap-2">
          <div class="w-6 h-6 rounded bg-primary text-on-primary flex items-center justify-center">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          Text to Handwriting
        </span>
        <button id="mobile-menu-close" class="p-1.5 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>

      <div class="flex-grow overflow-y-auto py-4 space-y-6 text-xs font-mono">
        <div>
          <span class="text-[10px] font-bold uppercase tracking-wider text-mute block mb-2 px-1">Handwriting Tools</span>
          <nav class="flex flex-col space-y-1">
            <a href="/" class="p-2 rounded-lg hover:bg-canvas text-primary font-semibold flex items-center gap-2.5">
              <span class="w-6 h-6 rounded bg-blue-50 dark:bg-blue-950/40 text-link flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
              </span>
              Text Converter
            </a>
            <a href="/bulk-generator" class="p-2 rounded-lg hover:bg-canvas text-primary font-semibold flex items-center gap-2.5">
              <span class="w-6 h-6 rounded bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
              </span>
              Bulk Generator
            </a>
            <a href="/assignment-formatter" class="p-2 rounded-lg hover:bg-canvas text-primary font-semibold flex items-center gap-2.5">
              <span class="w-6 h-6 rounded bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </span>
              Assignment Maker
            </a>
            <a href="/signature-generator" class="p-2 rounded-lg hover:bg-canvas text-primary font-semibold flex items-center gap-2.5">
              <span class="w-6 h-6 rounded bg-purple-50 dark:bg-purple-950/40 text-purple-600 dark:text-purple-400 flex items-center justify-center shrink-0">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
              </span>
              Signature Maker
