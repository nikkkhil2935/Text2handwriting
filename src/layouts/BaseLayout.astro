---
import '../styles/global.css';
import CookieConsent from '../components/common/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  schema?: Record<string, any>;
  showHeroGradient?: boolean;
  activeTab?: string;
  fullWidth?: boolean;
}

const siteUrl = 'https://texttohandwriting.me';
const cleanPath = Astro.url.pathname.replace(/\/+$/, '');
const finalCanonicalUrl = Astro.props.canonicalUrl || (cleanPath === '' ? `${siteUrl}/` : `${siteUrl}${cleanPath}`);

const {
  title,
  description,
  canonicalUrl = finalCanonicalUrl,
  ogImage = '/og-image.png',
  ogType = 'website',
  schema,
  showHeroGradient = false,
  activeTab = '',
  fullWidth = false
} = Astro.props;

// Build breadcrumb list schema automatically
const urlPaths = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = urlPaths.map((path, idx) => ({
  '@type': 'ListItem',
  'position': idx + 1,
  'name': path.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()),
  'item': `${siteUrl}/${urlPaths.slice(0, idx + 1).join('/')}`
}));

const breadcrumbSchema = urlPaths.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  'itemListElement': breadcrumbItems
} : null;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  'name': 'Text to Handwriting',
  'url': siteUrl
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  'name': 'Text to Handwriting',
  'url': siteUrl,
  'logo': `${siteUrl}/favicon.svg`
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) — deferred until cookie consent is given. The
         AdSense SDK is NOT loaded here: ad-slot components load it lazily,
         consent-gated, only on pages that actually render an ad unit. -->
    <script is:inline>
      // Analytics stay off until the user accepts in the cookie banner.
      // The dataLayer/gtag stub remains active so any gtag() calls are queued and
      // replayed once the real script loads (standard GA behavior).
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      window.__loadAnalytics = function () {
        if (window.__analyticsLoaded) return;
        window.__analyticsLoaded = true;

        var gtagScript = document.createElement('script');
        gtagScript.async = true;
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-TEY89MX99W';
        document.head.appendChild(gtagScript);
        gtag('js', new Date());
        gtag('config', 'G-TEY89MX99W');
      };

      (function () {
        try {
          if (localStorage.getItem('cookie-consent') === 'accepted') {
            window.__loadAnalytics();
          }
        } catch (e) {
          // localStorage unavailable — keep third-party scripts off
        }
      })();
    </script>

    <!-- Theme init — runs before first paint to avoid a flash. Dark mode is
         driven by the .dark class on <html>, set from the system preference by
         default or a persisted choice in localStorage. -->
    <script is:inline>
      (function () {
        var dark = false;
        try {
          var stored = localStorage.getItem('theme');
          dark = stored === 'dark' || (!stored && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        } catch (e) {
          dark = !!(window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }
        if (dark) document.documentElement.classList.add('dark');
      })();
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Text to Handwriting" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="msvalidate.01" content="535FF23B7A4B19C33E26225541987ADC" />

    <!-- Google AdSense account declaration (no scripts load until consent) -->
    <meta name="google-adsense-account" content="ca-pub-9725731987817847" />

    <!-- Google Fonts Preconnect and Prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono&display=swap" rel="stylesheet" />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteUrl)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, siteUrl)} />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}
    {breadcrumbSchema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    )}

  </head>
  <body class="relative flex flex-col min-h-screen bg-canvas-soft text-ink font-sans selection:bg-primary selection:text-on-primary antialiased">
    
    <!-- Background Gradient (Vercel-like) -->
    {showHeroGradient && (
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1400px] h-[550px] overflow-hidden pointer-events-none z-0 opacity-40 dark:opacity-20 transition-opacity">
        <div class="absolute top-[-10%] left-[-10%] w-[120%] h-[120%] bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-300 via-violet-300 to-transparent blur-[120px] dark:from-blue-900 dark:via-purple-900"></div>
      </div>
    )}

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 w-full bg-canvas/80 backdrop-blur-md border-b border-hairline py-4 px-6 md:px-12 flex items-center justify-between transition-colors">
      <div class="flex items-center space-x-8">
        <a href="/" class="flex items-center space-x-2 text-primary hover:opacity-90 font-mono tracking-tighter font-semibold text-lg">
          <img src="/favicon.svg" alt="Logo" class="w-5 h-5" />
          <span>Text to Handwriting</span>
        </a>
        <nav class="hidden xl:flex items-center space-x-1 text-xs font-medium">
          <a href="/" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'home' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Text Converter</a>
          <a href="/bulk-generator" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'bulk' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Bulk Generator</a>
          <a href="/assignment-formatter" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'assignment' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Assignment Maker</a>
          <a href="/signature-generator" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'signature' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Signature Maker</a>
          <a href="/notebook-paper-generator" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'notebook' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Notebook Paper</a>
          <a href="/text-to-cursive" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'cursive' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Cursive Converter</a>
          <a href="/handwriting-font-preview" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'font-preview' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Fonts</a>
          <a href="/blog" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'blog' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>Blog</a>
          <a href="/faq" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'faq' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>FAQ</a>
          <a href="/about-us" class={`px-2.5 py-1.5 rounded-full transition-colors ${activeTab === 'about' ? 'text-primary bg-canvas-soft-2 font-semibold' : 'text-body hover:text-primary hover:bg-canvas-soft-2/50'}`}>About</a>
        </nav>
      </div>
      
      <div class="flex items-center space-x-4">
        <!-- Theme Toggle -->
        <button id="theme-toggle" class="p-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body hover:text-primary cursor-pointer transition-colors" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="theme-icon-moon w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <svg class="theme-icon-sun w-[18px] h-[18px]" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
        </button>
        <!-- Mobile Menu Trigger -->
        <button id="mobile-menu-toggle" class="lg:hidden p-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body hover:text-primary cursor-pointer transition-colors" aria-label="Open navigation menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        </button>
      </div>
    </header>

    <!-- Mobile Drawer Overlay Menu -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-canvas-soft/95 backdrop-blur-md translate-x-full transition-transform duration-300 flex flex-col p-8 lg:hidden">
      <div class="flex items-center justify-between mb-8">
        <span class="font-mono font-semibold tracking-tighter text-lg text-primary flex items-center">
          <img src="/favicon.svg" alt="Logo" class="w-5 h-5 mr-2" />
          Text to Handwriting
        </span>
        <button id="mobile-menu-close" class="p-2 rounded-full border border-hairline bg-canvas hover:bg-canvas-soft text-body cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <nav class="flex flex-col space-y-2 text-sm font-mono mb-8 overflow-y-auto max-h-[60vh]">
        <a href="/" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Text Converter</a>
        <a href="/bulk-generator" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Bulk Handwriting Maker</a>
        <a href="/assignment-formatter" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Assignment Maker</a>
        <a href="/signature-generator" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Signature Maker</a>
        <a href="/notebook-paper-generator" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Notebook Paper</a>
        <a href="/handwriting-font-preview" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Font Preview</a>
        <a href="/text-to-cursive" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Cursive Converter</a>
        <a href="/faq" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">FAQ</a>
        <a href="/blog" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Blog</a>
        <a href="/about-us" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">About Us</a>
        <a href="/contact-us" class="py-2 border-b border-hairline text-primary hover:pl-2 transition-all">Contact Us</a>
      </nav>
      <div class="mt-auto pt-6 border-t border-hairline text-center">
        <p class="text-xs text-mute font-mono">texttohandwriting.me</p>
      </div>
    </div>

    <!-- Main Content Slot -->
    <main class={`relative flex-grow z-10 w-full ${fullWidth ? 'max-w-full px-4 md:px-8' : 'max-w-[1400px] mx-auto px-6 md:px-12'} py-8 transition-all`}>
      <slot />
    </main>

    <!-- Footer Area -->
    <footer class="relative z-10 w-full bg-canvas border-t border-hairline py-12 px-6 md:px-12 mt-auto transition-colors">
      <div class="max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="space-y-4">
          <span class="font-mono font-bold tracking-tighter text-primary flex items-center">
            <img src="/favicon.svg" alt="Logo" class="w-5 h-5 mr-2" />
            Text to Handwriting
          </span>
          <p class="text-xs text-body leading-relaxed">
            The premium text-to-handwriting platform. Generate highly realistic handwritten notes, custom signatures, school assignments, and printable notebook papers dynamically with our OffscreenCanvas worker engine.
          </p>
          <p class="text-xs text-mute font-mono">
            © 2020–2026 texttohandwriting.me. All Rights Reserved.
          </p>
        </div>
        <div>
          <h4 class="text-xs font-mono uppercase font-semibold text-primary mb-4 tracking-wider">Features</h4>
          <ul class="space-y-2 text-xs font-medium text-body">
            <li><a href="/" class="hover:text-primary transition-colors">Home Text Converter</a></li>
            <li><a href="/bulk-generator" class="hover:text-primary transition-colors">Bulk Handwriting Maker</a></li>
            <li><a href="/assignment-formatter" class="hover:text-primary transition-colors">Assignment Maker</a></li>
            <li><a href="/signature-generator" class="hover:text-primary transition-colors">Signature Generator</a></li>
            <li><a href="/notebook-paper-generator" class="hover:text-primary transition-colors">Notebook Paper Maker</a></li>
            <li><a href="/handwriting-font-preview" class="hover:text-primary transition-colors">Font Showcase Preview</a></li>
            <li><a href="/text-to-cursive" class="hover:text-primary transition-colors">Cursive Converter</a></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-mono uppercase font-semibold text-primary mb-4 tracking-wider">Info & Support</h4>
          <ul class="space-y-2 text-xs font-medium text-body">
            <li><a href="/faq" class="hover:text-primary transition-colors">Help & FAQ Hub</a></li>
            <li><a href="/about-us" class="hover:text-primary transition-colors">About Text to Handwriting</a></li>
            <li><a href="/contact-us" class="hover:text-primary transition-colors">Contact Us</a></li>
            <li><a href="/blog" class="hover:text-primary transition-colors">Blog & Guides</a></li>
            <li><span class="text-mute font-mono text-[10px]">DPI: 300 (Print Quality)</span></li>
            <li><span class="text-mute font-mono text-[10px]">Processing: Client-side</span></li>
          </ul>
        </div>
        <div>
          <h4 class="text-xs font-mono uppercase font-semibold text-primary mb-4 tracking-wider">Legal & Map</h4>
          <ul class="space-y-2 text-xs font-medium text-body">
            <li><a href="/privacy-policy" class="hover:text-primary transition-colors">Privacy Policy</a></li>
            <li><a href="/terms-and-conditions" class="hover:text-primary transition-colors">Terms & Conditions</a></li>
            <li><a href="/disclaimer" class="hover:text-primary transition-colors">Disclaimer</a></li>
            <li><a href="/website-credit" class="hover:text-primary transition-colors">Website Credit</a></li>
            <li><a href="/dmca" class="hover:text-primary transition-colors">DMCA Policy</a></li>
            <li>
              <div class="flex space-x-2 font-mono text-[10px] mt-2 pt-2 border-t border-hairline">
                <a href="/sitemap.xml" class="text-mute hover:text-primary">sitemap.xml</a>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </footer>

    <!-- Navigation Scripts -->
    <script is:inline>
      // Mobile Menu
      const mobileToggle = document.getElementById('mobile-menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileClose = document.getElementById('mobile-menu-close');

      if (mobileToggle && mobileMenu) {
        mobileToggle.addEventListener('click', () => {
          mobileMenu.classList.remove('translate-x-full');
        });
      }
      if (mobileClose && mobileMenu) {
        mobileClose.addEventListener('click', () => {
          mobileMenu.classList.add('translate-x-full');
        });
      }

      // Close menu when clicking links
      const mobileLinks = mobileMenu?.querySelectorAll('a');
      mobileLinks?.forEach(link => {
        link.addEventListener('click', () => {
          mobileMenu?.classList.add('translate-x-full');
        });
      });

      // Theme toggle — persists the choice; follows the OS otherwise
      const themeToggle = document.getElementById('theme-toggle');
      if (themeToggle) {
        const applyTheme = (dark, persist) => {
          document.documentElement.classList.toggle('dark', dark);
          themeToggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
          try {
            if (persist) {
              localStorage.setItem('theme', dark ? 'dark' : 'light');
            } else {
              localStorage.removeItem('theme');
            }
          } catch (e) { /* storage unavailable — keep theme in-session */ }
        };

        // Sync label with the state already applied by the head script
        // (without touching storage — the head script owns the initial state)
        themeToggle.setAttribute('aria-label', document.documentElement.classList.contains('dark') ? 'Switch to light mode' : 'Switch to dark mode');

        themeToggle.addEventListener('click', () => {
          applyTheme(!document.documentElement.classList.contains('dark'), true);
        });

        // Live-update when the OS preference changes, unless the user chose a theme
        if (window.matchMedia) {
          const mq = window.matchMedia('(prefers-color-scheme: dark)');
          const onSystemChange = (e) => {
            try {
              if (!localStorage.getItem('theme')) applyTheme(e.matches, false);
            } catch (err) { /* ignore */ }
          };
          if (mq.addEventListener) mq.addEventListener('change', onSystemChange);
          else if (mq.addListener) mq.addListener(onSystemChange);
        }
      }
    </script>
    <CookieConsent />
  </body>
</html>
